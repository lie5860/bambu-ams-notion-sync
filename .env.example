# Web console port. Docker overrides ADMIN_HOST to 0.0.0.0 inside the container.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3030

# Optional persistent paths. Docker writes both files under ./data.
APP_CONFIG_FILE=./data/app-config.json
BAMBU_CLOUD_TOKEN_FILE=./data/bambu-cloud.json

# Optional defaults. You can also set them in the Web console.
BAMBU_CONNECTION_MODE=cloud
BAMBU_UID_FIELDS=tray_uuid,tag_uid
PUSHALL_INTERVAL_MS=600000
DRY_RUN=true
LOG_LEVEL=info

# Optional: set these here only if you prefer env files over the Web console.
BAMBU_PRINTER_SERIAL=
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
