# Required: cloud is recommended because it works even when the printer is not on this network.
BAMBU_CONNECTION_MODE=cloud
BAMBU_PRINTER_SERIAL=01PXXXXXXXXXXXX

# Required: Notion integration token and target page/database/data source id.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATA_SOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# First run: keep true to preview Notion writes. Set false after the preview looks right.
DRY_RUN=true

# Optional: only needed for local MQTT mode.
BAMBU_PRINTER_IP=192.168.1.100
BAMBU_ACCESS_CODE=12345678

# Optional names and storage paths.
BAMBU_PRINTER_NAME=Bambu Printer
BAMBU_CLOUD_TOKEN_FILE=.bambu-cloud.json
NOTION_AMS_DATABASE_NAME=AMS 耗材
NOTION_TITLE_PROP=AMS 耗材
